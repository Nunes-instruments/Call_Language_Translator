DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER=
STT_PROVIDER=
STT_API_KEY=
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=
APP_URL=http://localhost:3000
REALTIME_URL=ws://localhost:8787
AUTH_SECRET=replace-with-a-long-random-secret
PORT=8787

# Independent call-leg integration is disabled by default.
# Test mode simulates provider calls only; it cannot approve live Plivo calls.
NUNES_INDEPENDENT_CALLS_ENABLED=false
NUNES_INDEPENDENT_CALLS_TEST_MODE=false
# Offline mock processing only; cannot authorize real providers or playback.
NUNES_OFFLINE_TRANSLATION_ENABLED=false

# Management API uses the existing server database and admin authentication.
NUNES_MANAGEMENT_ENABLED=false
NUNES_MANAGEMENT_API_URL=http://127.0.0.1:8787
NUNES_ADMIN_PASSWORD=
NUNES_VIEWER_PASSWORD=
DATABASE_URL_UNPOOLED=
