{
    "extends":  "../../tsconfig.base.json",
    "compilerOptions":  {
                            "module":  "ESNext",
                            "moduleResolution":  "Bundler",
                            "target":  "ES2022",
                            "types":  [
                                          "node"
                                      ],
                            "noEmit":  true
                        },
    "include":  [
                    "src/**/*.ts"
                ],
    "exclude":  [
                    "src/test-translation.ts",
                    "src/test-safe-translation.ts",
                    "src/test-sarvam.ts",
                    "src/**/*.bak"
                ]
}
